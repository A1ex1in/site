NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Не менее 32 случайных символов. Никогда не коммитьте настоящий секрет.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_MAX_AGE_HOURS=8
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false

# Можно использовать DATABASE_URL вместо отдельных DB_* переменных.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=site
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSL=false
# DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/site

FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
STORAGE_ROOT=./storage

# Включить после добавления утверждённых документов и чекбоксов на frontend.
REQUIRE_LEGAL_CONSENTS=false
PRIVACY_POLICY_VERSION=1.0
USER_AGREEMENT_VERSION=1.0
